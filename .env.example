# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. Never put real production secrets in it.
# Format: KEY=value — no quotes, no spaces around "=".

APP_ENV=local
# 127.0.0.1 = only reachable from your Mac (avoids the macOS firewall prompt).
# In the container we'll use :8080 (all interfaces).
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=debug
LOG_FORMAT=text

REQUEST_TIMEOUT=5s
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# Locally there is no load balancer to drain, so stop immediately.
# Kubernetes will use SHUTDOWN_DELAY=5s.
SHUTDOWN_DELAY=0s
SHUTDOWN_TIMEOUT=20s
